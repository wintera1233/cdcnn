{
  "pca_config": "configs/pca.json",
  "source_batch": 1,
  "cv": {
    "folds": 5,
    "seed": 42,
    "scoring": "accuracy",
    "duplicate_policy": "Exact duplicate feature vectors are assigned to one fold"
  },
  "search": {
    "pca_variance_retention": [0.90, 0.95, 0.99],
    "C": [0.1, 1, 10, 100, 1000],
    "gamma": ["scale", 0.001, 0.01, 0.1]
  },
  "pipeline": {
    "scaler": "StandardScaler",
    "pca": {"svd_solver": "full", "whiten": false},
    "classifier": "SVC",
    "kernel": "rbf"
  }
}
